{
  "name": "monkeytype-local-analytics",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "build": "node scripts/build.cjs",
    "install:local": "node scripts/install-local.cjs",
    "package": "npm run build && python3 scripts/package.py",
    "verify": "npm test && npm run check && npm run package",
    "test:browser": "node scripts/browser-smoke.cjs",
    "test:ui": "node scripts/browser-ui.cjs",
    "test:view": "node scripts/browser-state.cjs"
  },
  "engines": {
    "node": ">=24"
  }
}
