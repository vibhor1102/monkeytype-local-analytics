{
  "manifest_version": 3,
  "name": "Monkeytype Typing Mistakes",
  "version": "1.3.0",
  "description": "See which characters you mistype on Monkeytype, right on the site. Saved only in this browser.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Typing mistakes on Monkeytype",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "https://monkeytype.com/*"
      ],
      "js": [
        "core.js",
        "collector.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://monkeytype.com/*"
      ],
      "js": [
        "relay.js",
        "dashboard.js",
        "integrated.js",
        "menu.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
